# Ethara Image Agent — local configuration.
# Copy to .env and fill in. Anything set here overrides what is saved in the UI.
# Nothing in this file is ever written into an image record or served over HTTP.

# Your OpenAI API key. This is the only line you need to use OpenAI.
OPENAI_API_KEY=

# Which provider runs a job when the UI does not say: claude | openai
# Leave blank to keep using Claude through the local `claude` CLI (no key, no per-image cost).
IMAGE_AGENT_PROVIDER=

# Optional. Only for a proxy or an OpenAI-compatible endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. Which model runs each stage. Blank falls back to the UI setting.
# The QA stage looks at the finished JPG, so its model must accept images.
OPENAI_MODEL_BRIEF=
OPENAI_MODEL_DESIGN=
OPENAI_MODEL_QA=

# Image mode: "html" renders a designed page (default), "image" generates the picture
# with an OpenAI image model and composites the headline + logo on top.
IMAGE_AGENT_MODE=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
